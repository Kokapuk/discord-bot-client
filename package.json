{
  "name": "discord-bot-client",
  "version": "0.1.3",
  "description": "Beautiful discord client for bot accounts (text and voice)",
  "type": "module",
  "author": {
    "name": "Kokapuk",
    "url": "https://github.com/Kokapuk"
  },
  "scripts": {
    "dev": "vite",
    "voice-test": "node ./main/ipc/voice/test.js",
    "rebuild": "npm rebuild @discordjs/opus --runtime=electron --target=42.0.0 --disturl=https://electronjs.org/headers --update-binary",
    "build": "tsc && vite build && yarn rebuild && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "tsc": "tsc"
  },
  "dependencies": {
    "@chakra-ui/react": "3.35.0",
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "@emotion/react": "11.14.0",
    "@kokapuk/application-loopback": "1.0.2",
    "@snazzah/davey": "0.1.11",
    "dayjs": "1.11.20",
    "discord.js": "14.26.4",
    "electron-store": "11.0.2",
    "lodash": "4.18.1",
    "next-themes": "0.4.6",
    "prism-media": "1.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "5.6.0",
    "react-router": "7.15.0",
    "react-string-replace": "2.0.1",
    "scheduler": "0.27.0",
    "speaker": "0.5.5",
    "use-context-selector": "2.0.0",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@types/lodash": "4.17.24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "42.0.0",
    "electron-builder": "26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "typescript": "6.0.3",
    "vite": "8.0.11",
    "vite-plugin-electron": "0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vite-tsconfig-paths": "6.1.1"
  },
  "main": "dist-electron/main.js"
}
